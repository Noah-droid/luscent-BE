# Use the official Playwright Python image as a base
FROM mcr.microsoft.com/playwright/python:v1.40.0-jammy

WORKDIR /app

# Install standard testing libraries and API server
RUN pip install --no-cache-dir \
    requests \
    locust \
    pytest \
    beautifulsoup4 \
    python-dotenv \
    fastapi \
    uvicorn

# Pre-install the Chromium browser
RUN playwright install chromium
RUN playwright install-deps chromium

# SECURITY: Create a non-privileged user
RUN useradd -m qairunner
# Ensure the workspace is writable
RUN mkdir -p /app && chown -R qairunner:qairunner /app

# Copy the API wrapper
COPY runner_api.py /app/runner_api.py
RUN chown qairunner:qairunner /app/runner_api.py

# Switch to the limited user
USER qairunner
WORKDIR /app

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PORT=8080


CMD ["uvicorn", "runner_api:app", "--host", "0.0.0.0", "--port", "8080"]
