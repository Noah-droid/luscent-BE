# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-ec2-public-ip,your-domain.com,localhost

# Database (Neon PostgreSQL - external)
PGHOST=your-neon-host.pooler.region.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=your-neon-password
PGSSLMODE=require
PGCHANNELBINDING=require
DB_SSL_REQUIRE=True

# Alternative: Local PostgreSQL (uncomment and use 'local-db' profile)
# POSTGRES_DB=qai_local
# POSTGRES_USER=qai_admin
# POSTGRES_PASSWORD=qai_secret_pass
# PGHOST=db
# PGPORT=5432
# PGDATABASE=qai_local
# PGUSER=qai_admin
# PGPASSWORD=qai_secret_pass
# DB_SSL_REQUIRE=False

# Database URL (auto-constructed if not set)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Redis / Celery (external Redis Cloud)
CELERY_BROKER_URL=redis://default:password@redis-host:port
CELERY_RESULT_BACKEND=redis://default:password@redis-host:port

# CORS
CORS_ORIGIN_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:3500,http://localhost:5173,https://your-domain.com
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=accept,authorization,content-type,user-agent,x-csrftoken,x-requested-with

# Security
SALT_KEY=your-salt-key-32-chars-min
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# Runner (E2B / Playwright)
QAI_RUNNER_URL=https://your-runner-url
QAI_RUNNER_SECRET=your-runner-secret

# E2B Sandbox
E2B_API_KEY=e2b_your_api_key
E2B_SANDBOX_TEMPLATE=qai-runner

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Resend)
RESEND_API_KEY=re_your-resend-key

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Frontend URL
FRONTEND_URL=https://your-domain.com

# Ports (optional)
# API_PORT=8000
# RUNNER_PORT=8080

# Network (for EC2 host networking, use 'host')
# NETWORK_MODE=bridge
# NETWORK_DRIVER=bridge